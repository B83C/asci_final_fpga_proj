use dvi::vga::Signals;
use dvi::vga::Counters;
use dvi::vga::Timing;
use dvi::vga::Timings;

/// VGA timing configuration for 1280x720 @ 60Hz
fn vga_timing() -> Timings<11> {
    Timings(
        Timing(1280, 110, 40, 220),
        Timing(720, 5, 5, 20),
    )
}

/// Power-on reset: holds reset high for 255 cycles after startup
entity power_on_reset(clk: clock) -> bool {
    reg(clk) rst_counter: uint<8> initial(255) =
        if rst_counter == 0 {
            0
        } else {
            trunc(rst_counter - 1)
        };
    rst_counter != 0
}

/// VGA display module with debounced buttons, LEDs, and a color bar test pattern
entity top_vga(
    clk: clock,
    rst: bool,
    buttons: [bool; 2],
    leds: inv &[bool; 2],
) -> Signals {
    let b0 = inst debouncer(clk, buttons[0]);
    let b1 = inst debouncer(clk, buttons[1]);

    reg(clk) led_reg: [bool; 2] = [b0, b1];
    set leds = &led_reg;

    let timings = vga_timing();
    let counters = timings.inst counters(clk);

    let section = trunc(counters.x >> 7u16);
    let (cr, cg, cb) = match section {
        0u16 => (255u8, 0u8, 0u8),
        1u16 => (0u8, 255u8, 0u8),
        2u16 => (0u8, 0u8, 255u8),
        3u16 => (255u8, 255u8, 0u8),
        4u16 => (0u8, 255u8, 255u8),
        5u16 => (255u8, 0u8, 255u8),
        _ => (0u8, 0u8, 0u8),
    };

    counters.with_color(cr, cg, cb)
}

/// DVI encoding and serialization layer
entity top_dvi(
    pixclk: clock,
    serdes_clk: clock,
    rst: bool,
    vga: Signals,
    tmds_clk_p: inv &bool,
    tmds_clk_n: inv &bool,
    tmds_d_p: [inv &bool; 3],
    tmds_d_n: [inv &bool; 3],
) {
    let ctl0 = vga.vsync `concat` vga.hsync;
    let ctl1 = [false; 2];
    let ctl2 = [false; 2];

    let tmds0 = inst tmds_encoder(pixclk, vga.r, ctl0, vga.active);
    inst tmds_serdes(pixclk, serdes_clk, rst, tmds0, tmds_d_p[0], tmds_d_n[0]);

    let tmds1 = inst tmds_encoder(pixclk, vga.g, ctl1, vga.active);
    inst tmds_serdes(pixclk, serdes_clk, rst, tmds1, tmds_d_p[1], tmds_d_n[1]);

    let tmds2 = inst tmds_encoder(pixclk, vga.b, ctl2, vga.active);
    inst tmds_serdes(pixclk, serdes_clk, rst, tmds2, tmds_d_p[2], tmds_d_n[2]);

    // Clock channel: always transmit 10'b1111100000
    inst tmds_serdes(
        pixclk, serdes_clk, rst,
        [true, true, true, true, true, false, false, false, false, false],
        tmds_clk_p, tmds_clk_n,
    );
}

/// Top-level entity with clock generation, reset, and DVI output
entity top(
    clk50: clock,
    buttons: [bool; 2],
    leds: inv &[bool; 2],
    tmds_clk_p: inv &bool,
    tmds_clk_n: inv &bool,
    tmds_d_p: [inv &bool; 3],
    tmds_d_n: [inv &bool; 3],
) {
    let pixclk: clock;
    let serdes_clk: clock;
    let locked: bool;
    inst clk_wiz_0 $(
        clk_in1: clk50,
        reset: false,
        locked: locked,
        clk_75: pixclk,
        clk_375: serdes_clk,
    );

    reg(pixclk) rstcnt: uint<8> initial(0) =
        if rstcnt != 255 {
            trunc(rstcnt + 1)
        } else {
            255
        };
    let rst = rstcnt != 255;

    let vga = inst top_vga(pixclk, rst, buttons, leds);
    inst top_dvi(pixclk, serdes_clk, rst, vga, tmds_clk_p, tmds_clk_n, tmds_d_p, tmds_d_n);
}

// ***********************************************************************
// The top_dvi and top entities above are used together with a clock
// wizard and TMDS serializer for driving a DVI monitor. The simulation
// entity below provides a simple VGA interface for testing.
// ***********************************************************************
entity top_simulation(
    clk: clock,
    hsync: inv &bool,
    vsync: inv &bool,
    r: inv &uint<8>,
    g: inv &uint<8>,
    b: inv &uint<8>,
    leds: inv &[bool; 2],
) {
    let vga = inst top_vga(clk, false, [false; 2], leds);

    set hsync = &vga.hsync;
    set vsync = &vga.vsync;
    set r = &vga.r;
    set g = &vga.g;
    set b = &vga.b;
}
