// mod top;

use dvi::vga::Counters;
use dvi::vga::Signals;
use dvi::vga::Timing;
use dvi::vga::Timings;

use std::conv::int_to_uint;
use std::io::rising_edge;

fn vga_timing() -> dvi::vga::Timings<14> {
  Timings(
    Timing(1280, 1280 + 110, 1280 + 110 + 40, 1280 + 110 + 40 + 220),
    Timing(720, 720 + 5, 720 + 5 + 5, 720 + 5 + 5 + 20),
    // x_pixels: 640,
    // x_front_porch: 16,
    // x_sync_width: 96,
    // x_back_porch: 48,
    // Timing(480, 490, 502, 535),
    // y_pixels: 480,
    // y_front_porch: 10,
    // y_sync_width: 12,
    // y_back_porch: 33,
  )
}

struct Phys {
  buttons: [bool; 2],
  leds: inv [bool; 2],
}

entity top(clk: clock, phy: Phys) -> Signals {
  // In order to set our circuit back to its initial state on startup, we'll
  // generate a reset signal to use later
  let rst = inst power_on_reset(clk);

  let timings = vga_timing();
  let counters = timings
      .inst counters(clk);


  // To keep the game running at a reasonable pace, we only evaluate a new game state every frame,
  // rather than every clock cycle
  let new_frame = inst rising_edge(clk, counters.vsync);

  // let game_state = inst fsmutil::pipelined_fsm(
  //   clk,
  //   (rst, GameState$( x: 300i18.to_fixed(), y: 200i18.to_fixed(), angle: 0i18.to_fixed() )),
  //   new_frame,
  //   pipeline(1) |clk, state| {
  //       let result = state
  //         .inst(_) next(clk, [false; 4]);
  //     reg;
  //       result
  //   }
  // );

  // inst(_) render_pipeline(clk, game_state, counters)
}


#[no_mangle(all)]
entity top_simulation(
  // Digital hardware is driven by a clock. Every time it flips from 0 to 1,
  // all the signals in our design will be re-computed
  clk: clock,

  // These are the signals we'll send to the display
  hsync: inv &bool,
  vsync: inv &bool,
  r: inv &uint<8>,
  g: inv &uint<8>,
  b: inv &uint<8>,
) {
  let vga_out = inst top(clk);

  set hsync = &vga_out.hsync;
  set vsync = &vga_out.vsync;
  set r = &vga_out.r;
  set g = &vga_out.g;
  set b = &vga_out.b;
}

// mod pll;

#[no_mangle(all)]
entity top_dvi(
    clk_50mhz: clock,
    tmds_clk_p: inv &bool,
    tmds_clk_n: inv &bool,
    tmds_d_p: [inv &bool; 3],
    tmds_d_n: [inv &bool; 3],
) {
    reg(clk_50mhz) rst initial(true) = false;

    let fast_clk = inst clk_wiz_0(clk_50mhz,  );

    // let fast_clk = inst pll::simple_pll::$<FBDIV: 36, IDIV: 3, ODIV: 4>(clk_27mhz, rst);
    let clk = inst gowin_primitives::clkdiv::<"5">(fast_clk, rst);

    inst top(clk)
        .inst to_dvi(clk) // Encode the signals as DVI.
        .inst transmit_gowin$(clk, rst, out_clk: fast_clk, tmds_clk_p, tmds_clk_n, tmds_d_p, tmds_d_n); // Output the serialized signals.

}

entity power_on_reset(clk: clock) -> bool {
  reg(clk) rst_counter: uint<4> initial(5) =
    if rst_counter == 0 {
      0
    } else {
      trunc(rst_counter-1)
    };
  rst_counter != 0
}

#[no_mangle(all)]
extern entity clk_wiz_0(
    clk_in1: clock,
    r#reset: bool,

    clk_375: inv bool,
    clk_75: inv bool,
    
    locked: inv bool,
);

struct PLL {
    clk_375: bool,
    clk_75: bool,

    locked: bool,
}

entity pll(
    clk_in1: clock,
    r#reset: bool,
) -> PLL {
     
    let (pll_out, pll_out_inv) = port;
    inst clk_wiz_0(clk_in1, r#reset, pll_out_inv.clk_375, pll_out_inv.clk_75, pll_out_inv.locked);

    pll_out
}

    
