# Convert SystemVerilog to flattened Verilog for librelane
# Usage: yosys -s ys/flatten.ys

plugin -i slang

# --ignore-initial: string-based static text init not needed for synthesis
# Use _yosys.sv files (async reset fix, no string/DS/initial)
# top_vga_flat wraps top_vga to avoid interface-port-at-top error
read_slang --ignore-initial \
  -Wno-duplicate-definition \
  ./src/defs.svh \
  ./src/state.sv \
  ./src/debouncer_yosys.sv \
  ./src/generic_counter.sv \
  ./src/generic_countdown_counter.sv \
  ./src/lfsr.sv \
  ./src/timing_counter_yosys.sv \
  ./src/pipe.sv \
  ./src/ascii_rom.sv \
  ./src/vga_if.sv \
  ./src/vga_timing.sv \
  ./src/display_pipeline_yosys.sv \
  ./src/top_vga.sv \
  ./src/top_vga_flat.sv

hierarchy -check -top top_vga_flat

proc
flatten
opt_expr
opt_clean

write_verilog -noattr ./build/top_vga_flat.v
